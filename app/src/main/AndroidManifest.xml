<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="true" />
    <!-- NFC가 없는 기기에서도 설치되게 한다. 태그 등록 화면에서만 NFC를 켠다 -->
    <uses-feature
        android:name="android.hardware.nfc"
        android:required="false" />

    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 장소 조건이 있는 과제를 촬영하는 순간에만 사용한다. 백그라운드 위치 권한은 요청하지 않는다. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        장소 선택 화면에서만 쓴다: OpenStreetMap 지도 그림(타일)을 받고,
        지도 가운데 좌표를 OSM Nominatim에 보내 주소를 받는다.
        과제·기록·사진·인증 위치 같은 앱 데이터는 어디로도 보내지 않는다.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 화면이 켜져 있을 때 태그 고유 ID만 읽는다. 태그에 쓰지 않는다 -->
    <uses-permission android:name="android.permission.NFC" />
    <!-- 재부팅 뒤에도 마감 알람을 다시 걸기 위해 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 잠금 중 항상 허용할 앱(런처, 전화, 문자, 알람, 설정)과 사용자 허용 목록을 찾기 위한 패키지 가시성 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
    </queries>

    <!--
        allowBackup=false: 인증 사진과 기록이 클라우드 백업으로 기기 밖에 나가지 않게 한다.
        Android 12부터는 allowBackup=false여도 기기 간 이전(새 폰으로 옮기기)은 일어나므로 dataExtractionRules로 그것도 막는다.
        usesCleartextTraffic=false: 지도·주소 요청을 HTTPS로만 보낸다 (Android 8~8.1은 기본값이 평문 허용이다).
    -->
    <application
        android:name=".GetFocusApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.GetFocus">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".lock.LockActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.getfuckocus.lock" />

        <!-- 마감·알림 알람 전용 (앱 내부 명시적 인텐트). 다른 앱이 보내지 못하게 내보내지 않는다 -->
        <receiver
            android:name=".task.DeadlineReceiver"
            android:exported="false" />

        <!-- 재부팅·업데이트 브로드캐스트만 받는다 -->
        <receiver
            android:name=".task.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 알림의 "완료" 버튼 전용. 다른 앱이 과제를 대신 완료하지 못하게 내보내지 않는다 -->
        <receiver
            android:name=".task.CheckInReceiver"
            android:exported="false" />

        <service
            android:name=".lock.AppBlockerService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>

</manifest>
